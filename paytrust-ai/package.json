{
  "name": "paytrust-ai",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
