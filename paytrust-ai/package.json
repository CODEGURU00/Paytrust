    "clsx": "^2.1.1",
    "lucide-react": "^0.453.0",
    "next": "16.4.5",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^2.5.2",
    "uuid": "^14.0.3",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
