# ---------------------------------------------------------------------------
# PayTrust AI environment variables
#
# Copy this file to `.env.local` and replace every placeholder with a real
# value. `.env.local` is git-ignored and must never be committed.
#
# Do NOT commit real credentials to `.env.example` or any tracked file.
# Do NOT use live payment credentials while running the QA suite.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Supabase (required)
# Project Settings -> API. The URL and anon key are public browser values.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never expose this to the browser. Used by payment webhooks,
# PayPal capture/bookkeeping and the demo seed script.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# PayPal (optional; payment-provider features are BLOCKED until configured)
# developer.paypal.com -> Apps & Credentials. Keep PAYPAL_ENV=sandbox for QA.
# ---------------------------------------------------------------------------
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
# Webhook ID from the webhook you create in the PayPal dashboard.
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id
# Optional: only needed if you render PayPal buttons client-side.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-client-id

# ---------------------------------------------------------------------------
# AI provider (optional; AI generation is BLOCKED until a valid key exists)
#
# AI_PROVIDER selects the backend: "nvidia" or "gemini". Leave it unset to
# auto-detect (NVIDIA preferred when its key is present).
#
# NVIDIA NIM — OpenAI-compatible endpoint. The default model is a REASONING
# model: it emits hidden reasoning tokens that count against `max_tokens`, so
# budgets must be several times the answer length or the response comes back
# empty with finish_reason=length. Expect 70-250s per call.
# ---------------------------------------------------------------------------
AI_PROVIDER=
NVIDIA_API_KEY=
NVIDIA_MODEL=mistralai/mistral-large-4-1t-a52b
# Raise these if you see "spent the entire ... budget on hidden reasoning".
NVIDIA_MAX_TOKENS_SUMMARY=8192
NVIDIA_MAX_TOKENS_STRUCTURED=12288
# Optional global override for NVIDIA_MAX_TOKENS.
NVIDIA_MAX_TOKENS=
# Optional override for the NVIDIA base URL (enterprise gateways).
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Request timeout in ms. MUST stay below the AI routes' maxDuration (300s),
# otherwise the platform kills the request first and the client sees an
# opaque "fetch failed" instead of a clean timeout error.
NVIDIA_TIMEOUT_MS=240000

# ---------------------------------------------------------------------------
# Google Gemini (alternative provider)
# aistudio.google.com/apikey. Prompt construction, JSON parsing and schema
# validation are unit-tested without a live key.
#
# NOTE: the free tier allows 5 generate-content requests per minute and
# 20 per day. Exceeding either is reported by the app as 503 with a
# Retry-After header - it is not an application error.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
# Optional model override; defaults to a current Gemini flash model.
GEMINI_MODEL=gemini-3.5-flash
# Request timeout in ms. Same rule as NVIDIA_TIMEOUT_MS: keep it below the
# AI routes' maxDuration of 300s.
GEMINI_TIMEOUT_MS=240000

# ---------------------------------------------------------------------------
# AI provider behaviour (optional)
# ---------------------------------------------------------------------------
# Backoff before retrying a transient provider capacity spike. 0 disables
# the wait (used by the unit tests). Leave unset for the default 1500/4000.
AI_RETRY_BACKOFF_MS=

# ---------------------------------------------------------------------------
# Application
# Used for auth redirects, QR links and seed data. No trailing slash.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Demo seed accounts (npm run seed)
# Change these for your own environment; never use real user credentials.
# ---------------------------------------------------------------------------
DEMO_PASSWORD=PayTrustDemo123!
DEMO_BUYER_EMAIL=buyer@paytrust.demo
DEMO_SELLER_EMAIL=seller@paytrust.demo
DEMO_WITNESS_EMAIL=witness@paytrust.demo
# Set to "true" to force DEMO_PASSWORD back onto existing demo accounts.
# Changing a password invalidates that account's active sessions, so this is
# off by default: re-seeding must not sign out a demo that is already running.
SEED_RESET_PASSWORD=false

# ---------------------------------------------------------------------------
# QA test configuration (optional)
# Base URL used by Playwright and scripts/qa/live-api.mjs.
# Playwright launches the installed Google Chrome via channel: "chrome".
# Install Chrome, or change `channel` in playwright.config.ts.
# ---------------------------------------------------------------------------
QA_APP_URL=http://localhost:3000
# Seconds between the AI checks in scripts/qa/live-api.mjs, so they cannot
# land inside the same provider minute (the free tier allows 5/minute).
QA_AI_SPACING_MS=15000
# Pin the transaction the live sweep exercises. Leave unset to resolve it by
# title through the buyer's own session.
QA_TRANSACTION_ID=
